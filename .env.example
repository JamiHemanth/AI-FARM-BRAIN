# PostgreSQL (Neon, Supabase, Railway, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_farm_brain?schema=public"
# Direct/session connection used by Prisma migrations. It may equal DATABASE_URL locally.
DIRECT_URL="postgresql://postgres:password@localhost:5432/ai_farm_brain?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Optional provider integrations; deterministic safe fallbacks remain available.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-5-mini"
WEATHER_API_KEY=""
WEATHER_PROVIDER="mock"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
DEMO_MODE="false"
